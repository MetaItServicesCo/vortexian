FROM python:3.12-slim

WORKDIR /app

# System dependencies for psycopg (PostgreSQL driver) and others
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libffi-dev \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for Docker layer caching
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# AI assistant: download the knowledge base embedding model into the image,
# so the server never fetches it at runtime (must match AI_EMBEDDING_MODEL)
ENV AI_MODEL_CACHE=/app/models
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('BAAI/bge-small-en-v1.5', cache_dir='/app/models')"

# Copy backend source code
COPY . .

EXPOSE 8000

# Run migrations then start server
CMD alembic upgrade head && uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
