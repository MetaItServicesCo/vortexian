# Copy to .env and fill in. Used by docker-compose (and by the backend when
# run locally from backend/ — copy it to backend/.env in that case).

# ---------- Database ----------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://bloguser:change-me@postgres:5432/blogdb

# ---------- Auth ----------
# JWT signing key: `openssl rand -hex 32`
SECRET_KEY=
# Required to create admin accounts via /register
ADMIN_SECRET_KEY=

# ---------- Email (SMTP) ----------
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587

# Weekly newsletter job. Keep false unless the backend runs a single worker,
# otherwise every worker sends its own copy.
ENABLE_NEWSLETTER_SCHEDULER=false

# ---------- Frontend ----------
NEXT_PUBLIC_SITE_URL=https://vortexiantech.com

# Local development only (npm run dev):
# BACKEND_URL=http://127.0.0.1:8000       # where /api and /uploads are proxied
# API_INTERNAL_URL=http://127.0.0.1:8000  # used by Server Components
